{
  "name": "ebay-enhance",
  "version": "1.0.0",
  "description": "Hide eBay listings you do not want, on search results and item pages.",
  "type": "module",
  "scripts": {
    "build": "rsbuild build --mode=development",
    "build:prod": "rsbuild build --mode=production",
    "build:watch": "rsbuild build --watch",
    "package": "bash scripts/package-extension.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "chrome-extension",
    "ebay",
    "typescript",
    "preact"
  ],
  "author": "carry0987",
  "license": "MIT",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "preact": "^10.29.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@carry0987/utils": "^3.10.3",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-preact": "^1.7.2",
    "@rsbuild/plugin-type-check": "^1.3.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
