{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "1.0",
  "minimum_chrome_version": "116",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_openPopup__",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "static/js/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "offscreen"],
  "host_permissions": ["https://beam-me-up-pairing.buck-f11.workers.dev/*"],
  "optional_permissions": ["cookies", "scripting"],
  "optional_host_permissions": ["https://slack.com/*", "https://app.slack.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://beam-me-up-pairing.buck-f11.workers.dev wss://beam-me-up-pairing.buck-f11.workers.dev"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "css/*.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
